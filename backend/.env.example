# Copy to .env and fill in. Never commit .env.
APP_ENV=local
LOG_LEVEL=INFO

# Supabase > Connect > Session pooler connection string. The postgresql:// prefix is accepted.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres

# Clerk Dashboard > API keys, from the same instance as the frontend publishable key. Backend only.
CLERK_SECRET_KEY=sk_test_replace_me

# Comma-separated frontend origins. Also used as the accepted Clerk token audience (azp).
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Azure OpenAI (LLM adapter). LLM_MODEL is the chat deployment name.
LLM_PROVIDER=azure_openai
LLM_API_KEY=replace_me
LLM_MODEL=interns-gpt-4.1
LLM_TIMEOUT_SECONDS=60
AZURE_OPENAI_ENDPOINT=https://YOUR_RESOURCE.openai.azure.com
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# Advisor RAG: Azure embedding deployment on the same resource as chat.
# EMBEDDING_MODEL is the Azure deployment name (width 1536). Indexing runs in-process
# in the background and does not block Scan Now / Scan All.
EMBEDDING_MODEL=text-embedding-ada-002
EMBEDDING_DIMENSIONS=1536
EMBEDDING_SIMILARITY_GATE=0.72
CHUNK_SIZE_CHARS=1200
CHUNK_OVERLAP_CHARS=150
INDEX_CONCURRENCY=1

HTTP_USER_AGENT=ExcelsoftSalesIntelligence/0.1 (+local; research)
HTTP_TIMEOUT_SECONDS=15
# Organizations scanned at once in Scan All. Each is a different host, so the 5-second
# per-host gap still applies. Scans release DB connections while waiting on sites or the model.
SCAN_ORG_CONCURRENCY=4
SCAN_MAX_CONCURRENT_SOURCES=4
SCAN_MAX_PAGES_PER_ORGANIZATION=10
SCAN_NEWS_ARTICLES_PER_HUB=5
# 0 = every Scan Now live-fetches approved pages. A positive value reuses bodies collected
# within that many hours (scheduled scans). Already-approved URLs skip LLM rediscovery and
# re-validation either way; unchanged bodies still skip signal extraction via content hash.
SCAN_REFRESH_HOURS=0

# Sales Persona live lookups. Only official domains listed here (plus tracked org websites).
PERSONA_LIVE_LOOKUP_ENABLED=true
PERSONA_ALLOWED_DOMAINS=honorlock.com,proctorio.com,meazurelearning.com,caveon.com,questionmark.com
PERSONA_MAX_LIVE_PAGES_PER_DOMAIN=3

# Sales Persona LLM only. When set, Persona uses Gemini; Advisor/scan stay on Azure above.
PERSONA_GEMINI_API_KEY=
PERSONA_GEMINI_MODEL=gemini-3.8-flash

# SAM.gov Get Opportunities Public API (DATA_SOURCES.md §2). Never commit a real key.
SAM_GOV_API_KEY=
# D1: switch to https://api.sam.gov/prod/opportunities/v2/search only after a keyed 200.
SAM_GOV_SEARCH_URL=https://api.sam.gov/opportunities/v2/search
# Application safeguard until the issued key's quota is verified — not SAM.gov's official quota.
SAM_GOV_DAILY_REQUEST_CAP=10
SAM_GOV_SEARCH_LIMIT=25

# USAspending.gov API v2 (DATA_SOURCES.md §3). No API key. Fail-soft after SAM/websites.
USASPENDING_ENABLED=true
USASPENDING_MAX_AWARDS_PER_ORG=8
