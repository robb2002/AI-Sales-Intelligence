# Copy to .env and fill in. Never commit .env.
APP_ENV=local
LOG_LEVEL=INFO

# Supabase > Connect > Session pooler connection string. The postgresql:// prefix is accepted.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:5432/postgres

# Clerk Dashboard > API keys, from the same instance as the frontend publishable key. Backend only.
CLERK_SECRET_KEY=sk_test_replace_me

# Comma-separated frontend origins. Also used as the accepted Clerk token audience (azp).
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Azure OpenAI (LLM adapter). LLM_MODEL is the chat deployment name.
LLM_PROVIDER=azure_openai
LLM_API_KEY=replace_me
LLM_MODEL=interns-gpt-4.1
LLM_TIMEOUT_SECONDS=60
AZURE_OPENAI_ENDPOINT=https://YOUR_RESOURCE.openai.azure.com
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# Advisor RAG: Azure embedding deployment on the same resource as chat.
# Deploy text-embedding-3-small; EMBEDDING_MODEL is that deployment name.
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_SIMILARITY_GATE=0.72
CHUNK_SIZE_CHARS=1200
CHUNK_OVERLAP_CHARS=150

HTTP_USER_AGENT=ExcelsoftSalesIntelligence/0.1 (+local; research)
HTTP_TIMEOUT_SECONDS=15
SCAN_ORG_CONCURRENCY=2
SCAN_MAX_CONCURRENT_SOURCES=4
SCAN_MAX_PAGES_PER_ORGANIZATION=10
SCAN_NEWS_ARTICLES_PER_HUB=5
# 0 = every Scan Now fetches live. A positive value reuses pages collected within that many hours.
# Unchanged page bodies still skip LLM extraction (content hash) even when this is 0.
SCAN_REFRESH_HOURS=0

# SAM.gov Get Opportunities Public API (DATA_SOURCES.md §2). Never commit a real key.
SAM_GOV_API_KEY=
# D1: switch to https://api.sam.gov/prod/opportunities/v2/search only after a keyed 200.
SAM_GOV_SEARCH_URL=https://api.sam.gov/opportunities/v2/search
# Application safeguard until the issued key's quota is verified — not SAM.gov's official quota.
SAM_GOV_DAILY_REQUEST_CAP=10
SAM_GOV_SEARCH_LIMIT=25
